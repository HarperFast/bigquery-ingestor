{
	"name": "@harperdb/bigquery-ingestor",
	"version": "1.0.0",
	"description": "BigQuery data ingestion plugin for Harper",
	"license": "Apache-2.0",
	"author": {
		"name": "Harper, Inc.",
		"email": "opensource@harperdb.io",
		"url": "https://harper.fast/"
	},
	"contributors": [],
	"homepage": "https://harper.fast/",
	"keywords": [
		"harperdb",
		"harper",
		"plugin",
		"bigquery"
	],
	"type": "module",
	"main": "dist/index.js",
	"exports": {
		".": "./src/index.js",
		"./config": "./config.yaml"
	},
	"bin": {
		"maritime-data-synthesizer": "./tools/maritime-data-synthesizer/cli.js"
	},
	"files": [
		"dist/",
		"schema/",
		"config.yaml",
		"LICENSE",
		"README.md"
	],
	"scripts": {
		"test": "node --test test/config-loader.test.js test/sync-engine.test.js test/bigquery-client.test.js test/generator.test.js test/multi-table-orchestrator.test.js",
		"test:integration": "harper-integration-test-run integrationTests/**/*.test.ts",
		"test:coverage": "node --test --experimental-test-coverage test/config-loader.test.js test/sync-engine.test.js test/bigquery-client.test.js test/generator.test.js test/multi-table-orchestrator.test.js",
		"test:config": "node examples/test-bigquery-config.js",
		"lint": "eslint .",
		"format": "prettier .",
		"format:check": "npm run format -- --check",
		"format:write": "npm run format -- --write",
		"prepare": "husky"
	},
	"dependencies": {
		"@google-cloud/bigquery": "^7.0.0",
		"harper": "^5.0.11",
		"yaml": "^2.8.1"
	},
	"devDependencies": {
		"@harperdb/code-guidelines": "^0.0.5",
		"@harperfast/integration-testing": "^0.4.0",
		"eslint": "^9.35.0",
		"husky": "^9.1.7",
		"prettier": "^3.6.2",
		"typescript": "^5.9.3"
	},
	"engines": {
		"node": ">=20"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=20",
			"onFail": "error"
		},
		"packageManager": {
			"name": "npm",
			"onFail": "error"
		}
	}
}
